# Copy this file to .env and fill in your own values. NEVER commit .env.
MONGO_URI=mongodb://127.0.0.1:27017/jobportal

# Same value as VITE_FIREBASE_PROJECT_ID in client/.env
FIREBASE_PROJECT_ID=

# Emails that become Admin (comma separated). Create these users in
# Firebase Console -> Authentication -> Add user.
ADMIN_EMAILS=admin@jobhub.com
